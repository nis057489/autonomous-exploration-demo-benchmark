<?xml version="1.0"?>
<!-- Roofless tunnel maze for modern Gazebo Harmonic and later.
Run: gz sim -r tunnel_maze_500.sdf
Free floor area: 492.48 m^2. Corridor clear width: 2.4 m.
Interior envelope: x [-1.2,31.2], y [-1.2,25.2] m.
Floor surface z=0; wall height 2.5 m. No external assets or robot models.
Connected network: 30 nodes, 37 edges, 8 independent cycles, 4 dead ends.
Candidate robot spawn XY: (0,0), (6,0), (0,6), (30,24).
Use robot-specific spawn Z to place wheels just above the floor.
No map is supplied to robots: explore with your existing SLAM/Nav2 launch.
Geometry uses filled solid rock between passages to avoid inaccessible voids.
-->
<sdf version="1.9">
  <world name="tunnel_maze_500">
    <gravity>0 0 -9.81</gravity>
    <physics name="1ms" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
