<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="long_t_intersection">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <scene>
      <ambient>0.75 0.75 0.75 1</ambient>
      <background>0.72 0.80 0.90 1</background>
      <shadows>false</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -1</direction>
    </light>

    <!-- Point lights keep the corridor visible even on renderers that do not
         apply the directional light or material ambient term consistently. -->
    <light name="stem_light_1" type="point">
      <pose>0 -24 4 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>1 0.98 0.92 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>22</range><constant>0.4</constant><linear>0.02</linear><quadratic>0.002</quadratic></attenuation>
    </light>
    <light name="stem_light_2" type="point">
      <pose>0 -10 4 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>1 0.98 0.92 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>22</range><constant>0.4</constant><linear>0.02</linear><quadratic>0.002</quadratic></attenuation>
    </light>
    <light name="cross_light_left" type="point">
      <pose>-20 0 4 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>1 0.98 0.92 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>28</range><constant>0.4</constant><linear>0.02</linear><quadratic>0.002</quadratic></attenuation>
    </light>
    <light name="cross_light_right" type="point">
      <pose>20 0 4 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>1 0.98 0.92 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>28</range><constant>0.4</constant><linear>0.02</linear><quadratic>0.002</quadratic></attenuation>
    </light>

    <!-- T-shaped floor: a 30 m stem and a 60 m cross corridor, both 4 m wide. -->
    <model name="t_intersection">
      <static>true</static>

      <link name="floor">
        <collision name="stem_collision">
          <pose>0 -15 -0.10 0 0 0</pose>
          <geometry><box><size>4 30 0.20</size></box></geometry>
        </collision>
        <visual name="stem_visual">
          <pose>0 -15 -0.10 0 0 0</pose>
          <geometry><box><size>4 30 0.20</size></box></geometry>
          <material><ambient>0.32 0.32 0.34 1</ambient><diffuse>0.38 0.38 0.40 1</diffuse></material>
        </visual>
        <collision name="cross_collision">
          <pose>0 0 -0.10 0 0 0</pose>
          <geometry><box><size>60 4 0.20</size></box></geometry>
        </collision>
        <visual name="cross_visual">
          <pose>0 0 -0.10 0 0 0</pose>
          <geometry><box><size>60 4 0.20</size></box></geometry>
          <material><ambient>0.32 0.32 0.34 1</ambient><diffuse>0.38 0.38 0.40 1</diffuse></material>
        </visual>
      </link>

      <!-- Each wall is 20 cm thick and 1.5 m tall, suitable for 2D lidar. -->
      <link name="walls">
        <collision name="stem_left_collision"><pose>-2.1 -16.05 0.75 0 0 0</pose><geometry><box><size>0.2 27.9 1.5</size></box></geometry></collision>
        <visual name="stem_left_visual"><pose>-2.1 -16.05 0.75 0 0 0</pose><geometry><box><size>0.2 27.9 1.5</size></box></geometry><material><diffuse>0.82 0.82 0.78 1</diffuse></material></visual>

        <collision name="stem_right_collision"><pose>2.1 -16.05 0.75 0 0 0</pose><geometry><box><size>0.2 27.9 1.5</size></box></geometry></collision>
        <visual name="stem_right_visual"><pose>2.1 -16.05 0.75 0 0 0</pose><geometry><box><size>0.2 27.9 1.5</size></box></geometry><material><diffuse>0.82 0.82 0.78 1</diffuse></material></visual>

        <collision name="stem_end_collision"><pose>0 -30.1 0.75 0 0 0</pose><geometry><box><size>4.4 0.2 1.5</size></box></geometry></collision>
        <visual name="stem_end_visual"><pose>0 -30.1 0.75 0 0 0</pose><geometry><box><size>4.4 0.2 1.5</size></box></geometry><material><diffuse>0.82 0.82 0.78 1</diffuse></material></visual>

        <collision name="cross_top_collision"><pose>0 2.1 0.75 0 0 0</pose><geometry><box><size>60.2 0.2 1.5</size></box></geometry></collision>
        <visual name="cross_top_visual"><pose>0 2.1 0.75 0 0 0</pose><geometry><box><size>60.2 0.2 1.5</size></box></geometry><material><diffuse>0.82 0.82 0.78 1</diffuse></material></visual>

        <collision name="cross_bottom_left_collision"><pose>-16.05 -2.1 0.75 0 0 0</pose><geometry><box><size>27.9 0.2 1.5</size></box></geometry></collision>
        <visual name="cross_bottom_left_visual"><pose>-16.05 -2.1 0.75 0 0 0</pose><geometry><box><size>27.9 0.2 1.5</size></box></geometry><material><diffuse>0.82 0.82 0.78 1</diffuse></material></visual>

        <collision name="cross_bottom_right_collision"><pose>16.05 -2.1 0.75 0 0 0</pose><geometry><box><size>27.9 0.2 1.5</size></box></geometry></collision>
        <visual name="cross_bottom_right_visual"><pose>16.05 -2.1 0.75 0 0 0</pose><geometry><box><size>27.9 0.2 1.5</size></box></geometry><material><diffuse>0.82 0.82 0.78 1</diffuse></material></visual>

        <collision name="cross_left_end_collision"><pose>-30.1 0 0.75 0 0 0</pose><geometry><box><size>0.2 4.4 1.5</size></box></geometry></collision>
        <visual name="cross_left_end_visual"><pose>-30.1 0 0.75 0 0 0</pose><geometry><box><size>0.2 4.4 1.5</size></box></geometry><material><diffuse>0.82 0.82 0.78 1</diffuse></material></visual>

        <collision name="cross_right_end_collision"><pose>30.1 0 0.75 0 0 0</pose><geometry><box><size>0.2 4.4 1.5</size></box></geometry></collision>
        <visual name="cross_right_end_visual"><pose>30.1 0 0.75 0 0 0</pose><geometry><box><size>0.2 4.4 1.5</size></box></geometry><material><diffuse>0.82 0.82 0.78 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Suggested robot start pose: x=0, y=-27, yaw=+90 degrees.
         No custom <gui> block is used: Gazebo Harmonic's complete default
         GUI configuration is more portable across Ogre / GPU setups. -->
  </world>
</sdf>
