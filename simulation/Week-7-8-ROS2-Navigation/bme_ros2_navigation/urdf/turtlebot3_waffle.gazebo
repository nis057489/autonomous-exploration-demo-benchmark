<?xml version="1.0"?>
<robot>
  <gazebo>
    <plugin
        filename="gz-sim-diff-drive-system"
        name="gz::sim::systems::DiffDrive">
        <topic>$(arg cmd_vel_topic)</topic>
        <left_joint>wheel_left_joint</left_joint>
        <right_joint>wheel_right_joint</right_joint>
        <wheel_separation>0.287</wheel_separation>
        <wheel_radius>0.033</wheel_radius>
        <max_linear_acceleration>1</max_linear_acceleration>
        <min_linear_acceleration>-1</min_linear_acceleration>
        <max_angular_acceleration>2</max_angular_acceleration>
        <min_angular_acceleration>-2</min_angular_acceleration>
        <max_linear_velocity>0.46</max_linear_velocity>
        <min_linear_velocity>-0.46</min_linear_velocity>
        <max_angular_velocity>1.9</max_angular_velocity>
        <min_angular_velocity>-1.9</min_angular_velocity>
        <odom_topic>$(arg odom_topic)</odom_topic>
        <!-- No tf_topic: robot_localization's EKF (publish_tf: true) is the sole
             publisher of odom -> base_footprint, fused from this odom topic + IMU.
             Also publishing raw wheel-odom tf here would race the EKF's tf for the
             same edge, flickering the robot's apparent pose between the two. -->
        <frame_id>$(arg frame_prefix)odom</frame_id>
        <child_frame_id>$(arg frame_prefix)base_footprint</child_frame_id>
        <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>

    <plugin
        filename="gz-sim-joint-state-publisher-system"
        name="gz::sim::systems::JointStatePublisher">
        <topic>$(arg joint_states_topic)</topic>
        <joint_name>wheel_left_joint</joint_name>
        <joint_name>wheel_right_joint</joint_name>
    </plugin>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>15</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
        <optical_frame_id>$(arg frame_prefix)camera_rgb_optical_frame</optical_frame_id>
        <camera_info_topic>$(arg camera_info_topic)</camera_info_topic>
      </camera>
      <always_on>1</always_on>
      <update_rate>20</update_rate>
      <visualize>true</visualize>
      <topic>$(arg camera_image_topic)</topic>
    </sensor>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <always_on>1</always_on>
      <update_rate>50</update_rate>
      <visualize>true</visualize>
      <topic>$(arg imu_topic)</topic>
      <enable_metrics>true</enable_metrics>
      <gz_frame_id>$(arg frame_prefix)imu_link</gz_frame_id>
    </sensor>
  </gazebo>

  <gazebo reference="base_scan">
    <sensor name="gpu_lidar" type="gpu_lidar">
      <update_rate>20</update_rate>
      <topic>$(arg scan_topic)</topic>
      <gz_frame_id>$(arg frame_prefix)base_scan</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>0.000000</min_angle>
            <max_angle>6.280000</max_angle>
          </horizontal>
        </scan>
        <!-- LDS-02 (Hitachi-LG), not the original LDS-01: 0.16-8m range vs
             LDS-01's 3.5m. Real LDS-01 range was too short for this world's
             open aisles/rooms, causing most beams to return no hit and
             starving both SLAM loop closure and frontier candidates of
             detail beyond a few meters. -->
        <range>
          <min>0.16</min>
          <max>8.0</max>
          <resolution>0.015</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
        <frame_id>$(arg frame_prefix)base_scan</frame_id>
      </lidar>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

</robot>
